        <!-- BrowserStack Per-Request CSV Writer -->
        <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Per-Request CSV Writer" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">import java.io.BufferedWriter
import java.io.FileWriter
import java.nio.file.Files
import java.nio.file.Paths

def artifactsDir = System.getenv(&quot;LT_USER_ARTIFACTS_DIR&quot;)
if (!artifactsDir) {
    log.warn(&quot;[custom-csv] LT_USER_ARTIFACTS_DIR not set; skipping per-request CSV&quot;)
    return
}

def writerKey = &quot;__custom_csv_writer__&quot;
def writer = props.get(writerKey)
if (writer == null) {
    synchronized (props) {
        writer = props.get(writerKey)
        if (writer == null) {
            Files.createDirectories(Paths.get(artifactsDir))
            def outPath = Paths.get(artifactsDir, &quot;per-request-metrics.csv&quot;).toString()
            writer = new BufferedWriter(new FileWriter(outPath, false))
            writer.write(&quot;timestamp,label,latency_ms,success,bytes,url\n&quot;)
            writer.flush()
            props.put(writerKey, writer)
            log.info(&quot;[custom-csv] writer initialized: &quot; + outPath)
        }
    }
}

synchronized (writer) {
    writer.write(prev.getTimeStamp() + &quot;,&quot; +
                 prev.getSampleLabel() + &quot;,&quot; +
                 prev.getTime() + &quot;,&quot; +
                 prev.isSuccessful() + &quot;,&quot; +
                 prev.getBytesAsLong() + &quot;,&quot; +
                 prev.getUrlAsString() + &quot;\n&quot;)
    writer.flush()
}</stringProp>
        </JSR223PostProcessor>
        <hashTree/>
      </hashTree>

      <!-- TearDown Thread Group for BrowserStack Artifacts -->
      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="tearDown Thread Group" enabled="true">
