      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Write Test Summary JSON" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.nio.file.Files
import java.nio.file.Paths

SampleResult.setIgnore()

def artifactsDir = System.getenv(&quot;LT_USER_ARTIFACTS_DIR&quot;) ?: &quot;./logs/artifacts&quot;
def outPath = Paths.get(artifactsDir, &quot;run-summary.json&quot;)
Files.createDirectories(outPath.parent)

def summary = [
    test_finished_at: System.currentTimeMillis(),
    note: &quot;Product Filter Load Test completed.&quot;,
    hint: &quot;Drop any custom test files (CSV / JSON / log / etc.) inside \$LT_USER_ARTIFACTS_DIR to have them captured by the BrowserStack Load Testing pipeline.&quot;,
]

def json = new groovy.json.JsonBuilder(summary).toPrettyString()
Files.write(outPath, json.getBytes(&quot;UTF-8&quot;))
log.info(&quot;Custom summary artifact written to: &quot; + outPath.toAbsolutePath())</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
